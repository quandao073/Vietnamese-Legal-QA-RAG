# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...
LLM_MODEL_MAIN=claude-sonnet-5-5
LLM_MODEL_SMALL=claude-haiku-5-5
LLM_MAX_TOKENS=1500
LLM_EFFORT=low
LLM_TEMPERATURE=0.1
LLM_MAX_CONCURRENCY=4
LLM_CACHE_ENABLED=false
PRICE_INPUT_PER_M=2
PRICE_OUTPUT_PER_M=10

# --- Models ---
EMBEDDING_MODEL=BAAI/bge-m3
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANK_ENABLED=true
DEVICE=cpu
HF_HOME=/data/models

# --- Retrieval ---
CHUNK_STRATEGY=article
RETRIEVAL_TOP_N_DENSE=30
RETRIEVAL_TOP_N_BM25=30
RETRIEVAL_RRF_K=60
RETRIEVAL_TOP_K=6
CONTEXT_TOKEN_BUDGET=6000
QUERY_REWRITE_ENABLED=true
MIN_RERANK_SCORE=0.2
# RERANK_TOP_N: số ứng viên đưa vào reranker; giảm (vd 10) để nhanh hơn trên CPU
RERANK_TOP_N=30
CITATION_LLM_VERIFY=false

# --- Ingest ---
CORPUS_MAX_DOCS=20000
EVAL_YUITC_SAMPLE=500
MAX_CHUNK_TOKENS=700
RANDOM_SEED=42

# --- Infra ---
QDRANT_URL=http://qdrant:6333
DATABASE_URL=postgresql+psycopg://legal:legal@postgres:5432/legalrag
REDIS_URL=redis://redis:6379/0
ADMIN_TOKEN=change-me
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_BASE=http://localhost:8000/api/v1
